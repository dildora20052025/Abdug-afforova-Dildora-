                    { id: 12, title: "12-mavzu. Massa markazi. Muvozanat turlari. Kuch momenti", plans: ["Og'irlik markazi", "Barqaror va beqaror muvozanat", "Kuch momenti"], theory: "Jismning og'irlik markazi va kuchning yelkaga ko'paytmasi momentni hosil qiladi.", formula: "M = F \\cdot l", example: "Piyodaning xoda yordamida muvozanat saqlashi.", simType: "moment" },
