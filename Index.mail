                    { id: 1, title: "1-mavzu. Kuchlarni qo'shish", plans: ["Kuch vektor kattalik sifatida", "Superpozitsiya prinsipi", "Kolleniar va burchak ostida kuchlarni qo'shish"], theory: "Kuch — jismga boshqa jismlar tomonidan ta'sir ko'rsatish natijasida uning tezligi o'zgarishi yoki deformatsiyalanishiga sabab bo'luvchi vektor kattalik. Jismga bir nechta kuch ta'sir etganda, ularning teng ta'sir etuvchi kuchi barcha kuchlarning geometrik yig'indisiga teng.", formula: "R = \\sqrt{F_1^2 + F_2^2 + 2F_1F_2\\cos\\alpha}", example: "Ikki kishi arqonni bitta tomonga 30 N va 40 N kuch bilan tortsa, umumiy kuch 70 N bo'ladi.", simType: "forces" },
                    { id: 2, title: "2-mavzu. Markazga intilma kuch", plans: ["Egri chiziqli harakat", "Markazga intilma tezlanish", "Kanal va traektoriya radiusiga bog'liqlik"], theory: "Jism egri chiziq bo'ylab harakatlanganda tezlik yo'nalishi o'zgarib turadi, bu ezdan markazga intilma tezlanishni hosil qiladi. Nyutonning ikkinchi qonuniga ko'ra bu tezlanishni markazga intilma kuch ta'minlaydi.", formula: "F_m = \\frac{mv^2}{r} = m\\omega^2r", example: "Burilishda ketayotgan avtomobilning g'ildiragi va yo'l orasidagi ishqalanish kuchi.", simType: "centripetal" },
                    { id: 3, title: "3-mavzu. Gravitatsiya maydonidagi harakat", plans: ["Umumiy tortishish qonuni", "Gravitatsiya doimiysi", "Kosmik tezliklar va Yer atrofida harakat"], theory: "Tabiatdagi barcha jismlar massalariga proporsional, orasidagi masofaning kvadratiga teskari proporsional kuch bilan tortishadi.", formula: "F = G \\frac{m_1 m_2}{r^2}, \\quad G = 6.67 \\cdot 10^{-11}", example: "Oyning Yer atrofida orbitada aylanishi.", simType: "gravity" },
                    { id: 4, title: "4-mavzu. Masalalar yechish", plans: ["Dinamika asosiy qonunlarini qo'llash", "Proyeksiyalash usullari"], theory: "Dinamika masalalarini yechishda barcha kuchlar chizilib, koordinatalar o'qiga proyeksiyalanadi.", formula: "ma_x = \\sum F_ix", example: "Poyezdning tormozlanish masofasini hisoblash.", simType: "problem" },
                    { id: 5, title: "5-mavzu. Jism og'irligining harakat turiga bog'liqligi", plans: ["Og'irlik kuchi va vazn farqi", "Tezlanishli harakatda vazn o'zgarishi", "Vaznsizlik va ortiqcha yuklanish"], theory: "Jismning tayanchga ko'rsatgan bosim kuchi uning og'irligi deyiladi. Tezlanish bilan harakatlanganda vazn o'zgaradi.", formula: "P = m(g \\pm a)", example: "Lift yuqoriga tezlanish bilan ko'tarilganda vaznning ortishi.", simType: "weight" },
                    { id: 6, title: "6-mavzu. Jismning bir nechta kuch ta'siridagi harakati", plans: ["To'la kuchlar sistemasi", "Ishqalanish va tortish kuchi"], theory: "Real jismga bir vaqtning o'zida og'irlik, reaksiya, ishqalanish va tortish kuchlari ta'sir qiladi.", formula: "F_{tort} - F_{ishq} = ma", example: "Avtomobilning tekis tezlanuvchan harakati.", simType: "multiforce" },
                    { id: 7, title: "7-mavzu. Masalalar yechish", plans: ["Bog'langan jismlar tizimi", "Bloklar dinamikasi"], theory: "Ip va bloklar orqali bog'langan jismlar harakatini birgalikdagi tenglamalar orqali yechish.", formula: "a = \\frac{(m_2-m_1)g}{m_1+m_2}", example: "Yuk ko'tarish mexanizmlari.", simType: "problem" },
                    { id: 8, title: "8-mavzu. Jismning qiya tekislikdagi harakati", plans: ["Qiya tekislik geometriyasi", "Kuchlarni proyeksiyalash"], theory: "Gorizontga burchak ostidagi tekislikda jismning harakat tezlanishi og'irlik kuchi tashkil etuvchisiga bog'liq.", formula: "a = g(\\sin\\alpha - \\mu\\cos\\alpha)", example: "Taxta yordamida bochka tushirish.", simType: "inclined" },
                    { id: 9, title: "9-mavzu. Jismni qiya tekislik bo'ylab ko'chirishda bajarilgan ish. Qiya tekislikning foydali ish koeffitsiyenti (FIKI)", plans: ["Mexanik ish va FIK", "Foydali va to'la ish"], theory: "Qiya tekislik kuchdan yutuq bersada, ishda yo'qotishlar bo'ladi. FIK foydali ishning to'la ishga nisbatidir.", formula: "\\eta = \\frac{A_{foy}}{A_{tol}} \\cdot 100\\%", example: "Pushta yordamida og'ir yukni ko'tarish.", simType: "efficiency" },
                    { id: 10, title: "10-mavzu. Masalalar yechish", plans: ["FIK va ish hisoblari"], theory: "Qiya tekislikka doir masalalarni tahlil qilish.", formula: "A = mgh", example: "Zavod konveyerlari samaradorligi.", simType: "problem" },
